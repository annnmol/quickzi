{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": [
        "./*"
      ],
      "@app/src/*": [
        "./src/*"
      ],
      "@app/src/components/*": [
        "./src/components/*"
      ],
      "@app/src/lib/*": [
        "./src/lib/*"
      ],
      "@app/src/store/*": [
        "./src/store/*"
      ],
      "@app/src/services/*": [
        "./src/services/*"
      ],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
